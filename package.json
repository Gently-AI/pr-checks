{
  "name": "pr-checks",
  "version": "3.0.0",
  "description": "A GitHub Action that manages required checks based on GitHub repository rulesets and file changes in pull requests",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gently-ai/pr-checks.git"
  },
  "keywords": [
    "github",
    "actions",
    "workflow",
    "automation",
    "path-filter",
    "pr-checks"
  ],
  "author": "Gently AI",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.12.1",
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "js-yaml": "4.1.1",
    "minimatch": "10.2.5"
  },
  "scripts": {
    "build": "tsc && ncc build lib/index.js -o dist --source-map --license licenses.txt",
    "lint": "eslint src/",
    "watch": "tsc && ncc build lib/index.js -o dist --source-map --license licenses.txt --watch",
    "package": "ncc build lib/index.js -o dist --source-map --license licenses.txt"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.15.30",
    "@vercel/ncc": "0.38.4",
    "eslint": "10.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.0"
  }
}
